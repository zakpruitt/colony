# What is built in the Old Crypt. A stone pillar floor to ceiling, in three pieces: pillar_top
# (the capital, its top two rows sunk into the ceiling), pillar_shaft (repeated down to the
# base, a joint across each drum) and pillar_foot (the base, on the floor). And alcoves set in
# the back wall, one holding a skull and one the stub of a candle that is not lit. Steel lit
# with silver and shaded with slate and dusk, as the doorway is; the pillar outlined in ink.
category = fx
size = 16x16

