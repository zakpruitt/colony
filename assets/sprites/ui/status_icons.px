# Status marks (spec 056): one small mark per status, drawn over a fighter in the world and
# three to a hero frame on the HUD. Each is a 7x7 shape with its own ink edge, bright on dark.
category = ui
size = 7x7

# Stunned: a yellow star (three circle the head).
[stunned]
...p...
..pbp..
ppbbbpp
pbbjbbp
ppbbbpp
.pbpbp.
.pp.pp.

# Taunting: a red "!" over it.
[taunting]
..ppp..
..p8p..
..p8p..
..p8p..
..ppp..
..p8p..
..ppp..

# Shielded: a cyan shield (in the world, an outline round the fighter).
[shielded]
ppppppp
pjiiiip
piiiihp
piiiihp
.piihp.
..php..
...p...

