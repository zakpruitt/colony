# Colony's pixel font: one part per glyph, drawn from the left edge of a 5x7 cell.
# Rows 0-4 are the cap height (the baseline is under row 4), rows 5-6 the descender.
# A glyph's advance is its drawn width plus one column of spacing; the advances live
# in pixel.png.import (character_ranges), one entry per part, in this order.
category = font
size = 5x8

