# Colony's UI font (spec 058): one part per glyph, drawn from the left edge of a 9x12 cell.
# Capitals and digits are rows 0-8 (the baseline is under row 8), the x-height is 6 (rows
# 3-8), descenders reach row 11. A glyph's advance is its drawn width plus one column of
# spacing (UiText works it out from the pixels); digits all advance 7, a space 4.
category = font
size = 9x12

