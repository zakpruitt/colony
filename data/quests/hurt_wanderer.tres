[gd_resource type="Resource" script_class="QuestDef" load_steps=25 format=3]

[ext_resource type="Script" path="res://sim/defs/quest_def.gd" id="1"]
[ext_resource type="Script" path="res://sim/defs/quest_line.gd" id="2"]

[sub_resource type="Resource" id="line_0"]
script = ExtResource("2")
beat = &"plea"
speaker = &"subject"
class_id = &""
text = "Help... please, over here!"

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
beat = &"plea"
speaker = &"subject"
class_id = &""
text = "Is someone there? I'm hurt!"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2")
beat = &"plea"
speaker = &"subject"
class_id = &""
text = "Oh, kind folk, spare a moment?"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("2")
beat = &"plea"
speaker = &"subject"
class_id = &""
text = "My leg... I can't go on alone."

[sub_resource type="Resource" id="line_4"]
script = ExtResource("2")
beat = &"arrive"
speaker = &"worker"
class_id = &""
text = "Easy now, I've got you."

[sub_resource type="Resource" id="line_5"]
script = ExtResource("2")
beat = &"arrive"
speaker = &"worker"
class_id = &""
text = "Let's have a look at you."

[sub_resource type="Resource" id="line_6"]
script = ExtResource("2")
beat = &"arrive"
speaker = &"worker"
class_id = &"cleric"
text = "Be still. The light is with you."

[sub_resource type="Resource" id="line_7"]
script = ExtResource("2")
beat = &"arrive"
speaker = &"worker"
class_id = &"cleric"
text = "Peace, friend. You're safe now."

[sub_resource type="Resource" id="line_8"]
script = ExtResource("2")
beat = &"work"
speaker = &"worker"
class_id = &""
text = "Hold still, nearly there..."

[sub_resource type="Resource" id="line_9"]
script = ExtResource("2")
beat = &"work"
speaker = &"worker"
class_id = &""
text = "This may sting a little."

[sub_resource type="Resource" id="line_10"]
script = ExtResource("2")
beat = &"work"
speaker = &"worker"
class_id = &""
text = "Breathe slow. That's it."

[sub_resource type="Resource" id="line_11"]
script = ExtResource("2")
beat = &"work"
speaker = &"worker"
class_id = &"cleric"
text = "Mercy, mend this one."

[sub_resource type="Resource" id="line_12"]
script = ExtResource("2")
beat = &"watch"
speaker = &"watcher"
class_id = &""
text = "Take your time, we'll wait."

[sub_resource type="Resource" id="line_13"]
script = ExtResource("2")
beat = &"watch"
speaker = &"watcher"
class_id = &""
text = "Hold the torch steady..."

[sub_resource type="Resource" id="line_14"]
script = ExtResource("2")
beat = &"watch"
speaker = &"watcher"
class_id = &""
text = "Poor soul. Lucky we came by."

[sub_resource type="Resource" id="line_15"]
script = ExtResource("2")
beat = &"watch"
speaker = &"watcher"
class_id = &"knight"
text = "I'll keep an eye on the dark."

[sub_resource type="Resource" id="line_16"]
script = ExtResource("2")
beat = &"done"
speaker = &"worker"
class_id = &""
text = "There. Good as new."

[sub_resource type="Resource" id="line_17"]
script = ExtResource("2")
beat = &"done"
speaker = &"worker"
class_id = &""
text = "Up you get, gently now."

[sub_resource type="Resource" id="line_18"]
script = ExtResource("2")
beat = &"done"
speaker = &"worker"
class_id = &"cleric"
text = "Go with the light, friend."

[sub_resource type="Resource" id="line_19"]
script = ExtResource("2")
beat = &"thanks"
speaker = &"subject"
class_id = &""
text = "Bless you, friend!"

[sub_resource type="Resource" id="line_20"]
script = ExtResource("2")
beat = &"thanks"
speaker = &"subject"
class_id = &""
text = "I'll tell the whole valley of you!"

[sub_resource type="Resource" id="line_21"]
script = ExtResource("2")
beat = &"thanks"
speaker = &"subject"
class_id = &""
text = "Thank you! I can walk again!"

