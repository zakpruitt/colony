[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
beat = &"arrive"
speaker = &"worker"
class_id = &""
text = "Ah, someone left us a riddle."

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2")
beat = &"arrive"
speaker = &"worker"
class_id = &"mage"
text = "Hush now, the stone is speaking."

[sub_resource type="Resource" id="line_3"]
script = ExtResource("2")
beat = &"work"
speaker = &"worker"
class_id = &""
text = "Ith... vael... no, vaeth."

[sub_resource type="Resource" id="line_4"]
script = ExtResource("2")
beat = &"work"
speaker = &"worker"
class_id = &""
text = "Rune of the hearth, rune of the road..."

[sub_resource type="Resource" id="line_5"]
script = ExtResource("2")
beat = &"work"
speaker = &"worker"
class_id = &""
text = "This bit is smudged, honestly."

[sub_resource type="Resource" id="line_6"]
script = ExtResource("2")
beat = &"watch"
speaker = &"watcher"
class_id = &""
text = "Can you read it? I can't."

[sub_resource type="Resource" id="line_7"]
script = ExtResource("2")
beat = &"watch"
speaker = &"watcher"
class_id = &""
text = "It's glowing. Is it meant to glow?"

[sub_resource type="Resource" id="line_8"]
script = ExtResource("2")
beat = &"watch"
speaker = &"watcher"
class_id = &""
text = "Quiet, the reading's going well."

[sub_resource type="Resource" id="line_9"]
